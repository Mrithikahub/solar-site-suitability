# Google Earth Engine Cloud project ID (https://code.earthengine.google.com/)
GEE_PROJECT_ID=your-gee-project-id

# Study region (configurable). Name must match a FAO GAUL level-1 unit.
REGION_NAME=Tamil Nadu
REGION_COUNTRY=India

# Backend
ALLOWED_ORIGINS=http://localhost:5173

# Live Earth Engine extraction in /predict (falls back to the cached 0.5° grid)
LIVE_GEE=1
LIVE_GEE_TIMEOUT_S=5
# For deployment (Render): paste the full JSON key of a GEE-registered service account
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: comma-separated extra origins / regex (e.g. Vercel preview URLs)
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
GEOCODER_USER_AGENT=solarsite/1.0 (+https://github.com/Mrithikahub/solar-site-suitability)
