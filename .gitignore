# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
frontend/.env.*
!frontend/.env.example
*service-account*.json
*service_account*.json
gee-key*.json
*-key.json
credentials*.json
*.pem

# ---------------------------------------------------------------- python
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# ---------------------------------------------------------------- node / frontend
node_modules/
frontend/dist/
.vercel/

# ---------------------------------------------------------------- large or regenerable data
# Overpass / Earth Engine / NASA POWER response caches (hundreds of MB; rebuilt on demand)
data/raw/cache/
# OSM distance indexes (rebuilt by model.build_dataset from the Overpass cache)
data/raw/*.npy
# live Earth Engine results cached by the API at runtime
data/cache/
# intermediate rasters, regenerated by model.tn_rasters / model.ahp
data/processed/tn_raster_stack.npz
data/processed/tn_ahp_score.npy
# PNG masters of the web layers (the API serves the WebP copies)
data/processed/layers/*.png
# full-resolution screenshots (optimised copies live in docs/screenshots)
report/screenshots/

# ---------------------------------------------------------------- misc
.claude/
*.log
.DS_Store
Thumbs.db
